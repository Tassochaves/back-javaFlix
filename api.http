@baseUrl = http://localhost:8080

### Signup
POST {{baseUrl}}/api/auth/signup
Content-Type: application/json

{
    "email": "myteste@mailinator.com",
    "password": "12345678",
    "fullName": "Teste Fulano"
}

### Login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
    "email": "myteste@mailinator.com",
    "password": "12345678"
}

### Validate email
GET {{baseUrl}}/api/auth/validate-email
    ?email=myteste@mailinator.com