@baseUrl = http://localhost:8080

### Signup
POST {{baseUrl}}/api/auth/signup
Content-Type: application/json

{
    "email": "myteste3@mailinator.com",
    "password": "12345678",
    "fullName": "Teste Fulano3"
}

### Login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
    "email": "myteste@mailinator.com",
    "password": "12345678"
}

### Validate email
GET {{baseUrl}}/api/auth/validate-email
    ?email=myteste@mailinator.com

### Verify email
GET {{baseUrl}}/api/auth/verify-email
    ?token=uuid-token-gerado-123

### resend email verification
POST {{baseUrl}}/api/auth/resend-verification
Content-Type: application/json

{
    "email": "myteste3@mailinator.com"
}